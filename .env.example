VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public address used in trainee invite links and in sign-up / password-reset
# emails. Not a secret. Production builds default to it when unset; local
# development falls back to the address the app is opened on. Set it in the
# Vercel project for Production.
# VITE_APP_URL=https://rk-fitness-six.vercel.app

# Public VAPID key for Web Push (the matching private key lives only in the
# Supabase Edge Function secrets). Not a secret. Without it the notifications
# card shows "not configured".
# VITE_VAPID_PUBLIC_KEY=
